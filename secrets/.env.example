# i-lab :: plantilla de variables de entorno
# Copiar a secrets/.env y rellenar.  secrets/.env NUNCA se sube a git.
#   cp secrets/.env.example secrets/.env && chmod 600 secrets/.env
# Generar valores aleatorios:  openssl rand -hex 32

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=ilab
POSTGRES_PASSWORD=
POSTGRES_DB=ilab
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379

# --- LiteLLM -----------------------------------------------------------------
# La master key es la que usan OpenHands, los gateways y los scripts.
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
LITELLM_PORT=4000

# --- Claves de proveedores (solo las que vayas a usar) -----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- OpenHands ---------------------------------------------------------------
OPENHANDS_VERSION=0.59
OPENHANDS_PORT=3000
OPENHANDS_MODEL=openai/opus-5

# --- Gateways ----------------------------------------------------------------
AGENT_BASE_URL=http://openhands:3000
GATEWAY_MODEL=sonnet-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_WEBHOOK_PORT=8081

# --- Observabilidad ----------------------------------------------------------
LANGFUSE_DB=langfuse
LANGFUSE_PORT=3001
LANGFUSE_PUBLIC_URL=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_USER=admin
GRAFANA_PASSWORD=
